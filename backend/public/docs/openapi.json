{
  "openapi": "3.0.3",
  "info": {
    "title": "Desafio Fênix – API de Provas Online",
    "version": "1.0.0",
    "description": "API REST de provas online.\n\n**Autenticação simplificada** (o desafio dispensa login): clique em *Authorize* e informe `X-Role` = `teacher` ou `student`; para aluno informe também `X-Student-Id` (ex.: 1)."
  },
  "servers": [
    {
      "url": "/api"
    }
  ],
  "tags": [
    {
      "name": "Alunos"
    },
    {
      "name": "Professor • Provas"
    },
    {
      "name": "Professor • Dashboard"
    },
    {
      "name": "Aluno"
    }
  ],
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          }
        }
      },
      "ValidationError": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "Student": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          }
        }
      },
      "Option": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "text": {
            "type": "string"
          },
          "is_correct": {
            "type": "boolean"
          }
        }
      },
      "PublicOption": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "text": {
            "type": "string"
          }
        }
      },
      "Question": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "statement": {
            "type": "string"
          },
          "position": {
            "type": "integer"
          },
          "options": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Option"
            }
          }
        }
      },
      "PublicQuestion": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "statement": {
            "type": "string"
          },
          "position": {
            "type": "integer"
          },
          "options": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PublicOption"
            }
          }
        }
      },
      "Exam": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "questions_count": {
            "type": "integer"
          },
          "attempts_count": {
            "type": "integer"
          },
          "questions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Question"
            }
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "StudentExam": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "questions_count": {
            "type": "integer"
          },
          "already_taken": {
            "type": "boolean"
          },
          "attempt_id": {
            "type": "integer",
            "nullable": true
          },
          "questions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PublicQuestion"
            }
          }
        }
      },
      "OptionInput": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 500
          },
          "is_correct": {
            "type": "boolean"
          }
        },
        "required": [
          "text",
          "is_correct"
        ]
      },
      "QuestionInput": {
        "type": "object",
        "properties": {
          "statement": {
            "type": "string",
            "maxLength": 1000
          },
          "options": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OptionInput"
            },
            "minItems": 2,
            "maxItems": 6,
            "description": "Exatamente UMA alternativa deve ter is_correct=true."
          }
        },
        "required": [
          "statement",
          "options"
        ]
      },
      "ExamInput": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 255
          },
          "description": {
            "type": "string",
            "maxLength": 2000,
            "nullable": true
          },
          "questions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/QuestionInput"
            },
            "minItems": 1
          }
        },
        "required": [
          "title",
          "questions"
        ]
      },
      "ExamUpdateInput": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 255
          },
          "description": {
            "type": "string",
            "maxLength": 2000,
            "nullable": true
          },
          "questions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/QuestionInput"
            },
            "minItems": 1,
            "description": "Opcional. Se a prova já tem tentativas, enviar questões retorna 409."
          }
        },
        "required": [
          "title"
        ]
      },
      "AttemptInput": {
        "type": "object",
        "properties": {
          "answers": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "question_id": {
                  "type": "integer"
                },
                "option_id": {
                  "type": "integer"
                }
              },
              "required": [
                "question_id",
                "option_id"
              ]
            },
            "minItems": 1,
            "description": "Uma resposta para CADA questão da prova."
          }
        },
        "required": [
          "answers"
        ]
      },
      "AttemptDetail": {
        "type": "object",
        "properties": {
          "question_id": {
            "type": "integer"
          },
          "statement": {
            "type": "string"
          },
          "selected_option": {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer"
              },
              "text": {
                "type": "string"
              }
            }
          },
          "correct_option": {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer"
              },
              "text": {
                "type": "string"
              }
            },
            "nullable": true
          },
          "is_correct": {
            "type": "boolean"
          }
        }
      },
      "Attempt": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "exam": {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer"
              },
              "title": {
                "type": "string"
              }
            }
          },
          "student": {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer"
              },
              "name": {
                "type": "string"
              }
            }
          },
          "score": {
            "type": "integer"
          },
          "total_questions": {
            "type": "integer"
          },
          "percentage": {
            "type": "number"
          },
          "submitted_at": {
            "type": "string",
            "format": "date-time"
          },
          "details": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AttemptDetail"
            }
          }
        }
      },
      "RankingItem": {
        "type": "object",
        "properties": {
          "rank": {
            "type": "integer",
            "nullable": true
          },
          "attempt_id": {
            "type": "integer"
          },
          "student": {
            "type": "string"
          },
          "exam": {
            "type": "string"
          },
          "score": {
            "type": "integer"
          },
          "total_questions": {
            "type": "integer"
          },
          "percentage": {
            "type": "number"
          },
          "submitted_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Stats": {
        "type": "object",
        "properties": {
          "total_attempts": {
            "type": "integer"
          },
          "average_percentage": {
            "type": "number"
          },
          "average_score": {
            "type": "number"
          },
          "best": {
            "$ref": "#/components/schemas/RankingItem",
            "nullable": true
          },
          "worst": {
            "$ref": "#/components/schemas/RankingItem",
            "nullable": true
          }
        }
      },
      "PaginatedRanking": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RankingItem"
            }
          },
          "links": {
            "type": "object",
            "properties": {
              "first": {
                "type": "string"
              },
              "last": {
                "type": "string"
              },
              "prev": {
                "type": "string",
                "nullable": true
              },
              "next": {
                "type": "string",
                "nullable": true
              }
            }
          },
          "meta": {
            "type": "object",
            "properties": {
              "current_page": {
                "type": "integer"
              },
              "per_page": {
                "type": "integer"
              },
              "total": {
                "type": "integer"
              },
              "last_page": {
                "type": "integer"
              }
            }
          }
        }
      }
    },
    "securitySchemes": {
      "Role": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Role",
        "description": "`teacher` ou `student`"
      },
      "StudentId": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Student-Id",
        "description": "ID do aluno (veja GET /students)"
      }
    }
  },
  "paths": {
    "/students": {
      "get": {
        "tags": [
          "Alunos"
        ],
        "summary": "Lista os alunos (usada na entrada do aluno)",
        "responses": {
          "200": {
            "description": "Lista de alunos",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Student"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/exams": {
      "get": {
        "tags": [
          "Professor • Provas"
        ],
        "summary": "Lista provas (cache Redis)",
        "security": [
          {
            "Role": []
          }
        ],
        "responses": {
          "200": {
            "description": "Provas",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Exam"
                      }
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Perfil sem permissão (header X-Role inválido)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Professor • Provas"
        ],
        "summary": "Cria prova com questões e alternativas",
        "security": [
          {
            "Role": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExamInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Prova criada",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Exam"
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Perfil sem permissão (header X-Role inválido)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Erro de validação",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/exams/{exam}": {
      "get": {
        "tags": [
          "Professor • Provas"
        ],
        "summary": "Detalha prova (com gabarito)",
        "security": [
          {
            "Role": []
          }
        ],
        "parameters": [
          {
            "name": "exam",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "ID da prova"
          }
        ],
        "responses": {
          "200": {
            "description": "Prova",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Exam"
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Perfil sem permissão (header X-Role inválido)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Recurso não encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "Professor • Provas"
        ],
        "summary": "Edita prova",
        "security": [
          {
            "Role": []
          }
        ],
        "description": "Se a prova já possui tentativas, só título/descrição podem mudar (enviar `questions` retorna 409).",
        "parameters": [
          {
            "name": "exam",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "ID da prova"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExamUpdateInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Prova atualizada",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Exam"
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Perfil sem permissão (header X-Role inválido)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Recurso não encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Prova já possui tentativas",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Erro de validação",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Professor • Provas"
        ],
        "summary": "Exclui prova (e questões, alternativas e tentativas)",
        "security": [
          {
            "Role": []
          }
        ],
        "parameters": [
          {
            "name": "exam",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "ID da prova"
          }
        ],
        "responses": {
          "204": {
            "description": "Excluída"
          },
          "403": {
            "description": "Perfil sem permissão (header X-Role inválido)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Recurso não encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/dashboard/stats": {
      "get": {
        "tags": [
          "Professor • Dashboard"
        ],
        "summary": "Média, melhor e pior pontuação (cache Redis)",
        "security": [
          {
            "Role": []
          }
        ],
        "parameters": [
          {
            "name": "exam_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            },
            "description": "Filtra por prova"
          }
        ],
        "responses": {
          "200": {
            "description": "Métricas",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Stats"
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Perfil sem permissão (header X-Role inválido)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Erro de validação",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/dashboard/ranking": {
      "get": {
        "tags": [
          "Professor • Dashboard"
        ],
        "summary": "Ranking paginado (cache Redis)",
        "description": "Ordenado por percentual, depois nota e depois por quem terminou antes.",
        "security": [
          {
            "Role": []
          }
        ],
        "parameters": [
          {
            "name": "exam_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            },
            "description": "Filtra por prova"
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1
            },
            "description": "Página"
          },
          {
            "name": "per_page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 10
            },
            "description": "Itens por página"
          }
        ],
        "responses": {
          "200": {
            "description": "Ranking",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginatedRanking"
                }
              }
            }
          },
          "403": {
            "description": "Perfil sem permissão (header X-Role inválido)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Erro de validação",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/student/exams": {
      "get": {
        "tags": [
          "Aluno"
        ],
        "summary": "Provas disponíveis (indica quais já foram feitas)",
        "security": [
          {
            "Role": [],
            "StudentId": []
          }
        ],
        "responses": {
          "200": {
            "description": "Provas",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/StudentExam"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Aluno não identificado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Perfil sem permissão (header X-Role inválido)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/student/exams/{exam}": {
      "get": {
        "tags": [
          "Aluno"
        ],
        "summary": "Abre a prova (SEM gabarito)",
        "security": [
          {
            "Role": [],
            "StudentId": []
          }
        ],
        "parameters": [
          {
            "name": "exam",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "ID da prova"
          }
        ],
        "responses": {
          "200": {
            "description": "Prova",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/StudentExam"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Aluno não identificado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Perfil sem permissão (header X-Role inválido)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Recurso não encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/student/exams/{exam}/attempts": {
      "post": {
        "tags": [
          "Aluno"
        ],
        "summary": "Submete respostas e recebe a correção automática",
